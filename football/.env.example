# Local football system configuration template.
# The setup script copies this file to football/.env on first run.

# Default analysis stake. Change this if you want a different amount.
STAKE_AMOUNT=800

# Compatibility alias used by older runner/helper modules.
STARTING_CAPITAL=800

CURRENCY=GHS

# Optional Telegram alerts.
# Leave these blank if you do not want Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional scraper/runtime controls.
MAX_PARALLEL_SCRAPERS=8
SCRAPER_GLOBAL_TIMEOUT=90