# Local football system configuration template.
# Copy this file to football/.env and fill in your local values.

STARTING_CAPITAL=500
CURRENCY=GHS

# Optional: only needed if notification features are enabled.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional scraper/runtime controls.
MAX_PARALLEL_SCRAPERS=8
SCRAPER_GLOBAL_TIMEOUT=90